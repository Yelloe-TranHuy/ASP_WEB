@{
    ViewData["Title"] = "Liên Hệ";
}

<div style="background-image: url('/images/private_background.gif'); background-size: cover; background-position: center; padding: 50px; backdrop-filter: blur(10px)">
    <div class="container" style="background-color: rgba(255, 255, 255, 0.3); padding: 40px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.2);">
        <h1 style="color: black; font-family: 'Cascadia Code', sans-serif; font-weight: bold; font-size: 3.5em; text-shadow: 2px 2px 5px rgba(0,0,0,0.3); text-align: center;">
            Contact Us
        </h1>

        <p style="font-size: 1.5em; color: black; line-height: 1.8; text-align: center; margin-top: 20px;">
            We are always ready to listen and support you. Below is the contact information for the computer store.
        </p>

        <div class="mt-4" style="text-align: center;">
            <div class="row">
                <div class="col-md-4">
                    <div style="font-size: 2em; color: #007bff;">
                        <i class="fas fa-phone-alt"></i>
                    </div>
                    <h3 style="color: black;">Phone</h3>
                    <p style="font-size: 1.2em; color: black;">0946855274</p>
                </div>
                <div class="col-md-4">
                    <div style="font-size: 2em; color: #007bff;">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <h3 style="color: black;">Email</h3>
                    <p style="font-size: 1.2em; color: black;">1822040665@dntu.edu.vn</p>
                </div>
                <div class="col-md-4">
                    <div style="font-size: 2em; color: #007bff;">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <h3 style="color:black;">Address</h3>
                    <p style="font-size: 1.2em; color:black;">Bien Hoa, Dong Nai</p>
                </div>
            </div>
        </div>

        <h2 style="color: black; font-family: 'Cascadia Code', sans-serif; font-weight: bold; font-size: 2.5em; margin-top: 30px; text-align: center;">
            Give us your information to contact
        </h2>

        <form method="post" action="~/Admin/Contact/ThankYou" style="margin-top: 20px; text-align: center;">
            <style>
                .form-label {
                    color: #000;
                }

                .form-control {
                    color: #000;
                }
            </style>
            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input type="text" class="form-control" id="name" name="name" required>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Your Email</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>
            <div class="mb-3">
                <label for="message" class="form-label">Your message</label>
                <textarea class="form-control" id="message" name="message" rows="4" required></textarea>
            </div>
            <!-- Centering the button -->
            <button type="submit" class="btn btn-primary mx-auto" style="display: block;">Send</button>
        </form>
    </div>
</div>
