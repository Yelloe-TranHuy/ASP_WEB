<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TH Computer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project_A.styles.css" asp-append-version="true" />

    <!-- Add any additional styles here -->
    <style>
        /* Your custom styles */
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" style="height: 40px;" class="me-2">
                    TH Computer
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- Your navigation links here -->
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody() <!-- This is the missing line you need -->
        </main>
    </div>

    <!-- Footer -->
    <!-- Footer -->
    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container">
            <div class="row">
                <!-- Logo and Company Info -->
                <div class="col-md-4">
                    <h5>TH Computer</h5>
                    <img src="~/images/logo.png" alt="Logo" style="height: 50px;" class="mb-2">
                    <p>We offer the best products for your needs.</p>
                </div>
                <!-- Contact Info -->
                <div class="col-md-4">
                    <h5>Contact Us</h5>
                    <p><i class="fas fa-phone-alt"></i> Phone: 0946855274</p> <!-- Your phone number -->
                    <p><i class="fas fa-envelope"></i> Email: tranhuymadao123@gmail.com</p> <!-- Your email address -->
                    <p><i class="fas fa-map-marker-alt"></i> Address: Biên Hoà, Đồng Nai, Vietnam</p> <!-- Your address -->
                </div>
                <!-- Quick Links -->
                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="~/Customer/Home/Index" class="text-white">Home</a></li>
                        <li><a href="~/Admin/Admin/GioiThieu" class="text-white">About</a></li>
                        <li><a href="~/Admin/Admin/ChinhSach" class="text-white">Services</a></li>
                        <li><a href="~/Admin/Admin/LienHe" class="text-white">Contact</a></li>
                    </ul>
                </div>
            </div>
            <div class="text-center mt-4">
                <p></p>
            </div>
        </div>
    </footer>
</body>
</html>
